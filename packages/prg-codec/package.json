{
  "name": "@graphif/prg-codec",
  "description": "Headless Project Graph .prg archive codec",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "cd ../.. && vitest run packages/prg-codec/tests/index.test.ts",
    "type-check": "tsc",
    "publish": "pnpm publish --no-git-checks"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@zip.js/zip.js": "^2.8.26"
  }
}
