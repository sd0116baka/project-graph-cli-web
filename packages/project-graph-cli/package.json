{
  "name": "@graphif/project-graph-cli",
  "description": "Command line tools for Project Graph documents",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "project-graph": "dist/index.mjs"
  },
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "cd ../.. && vitest run --config packages/project-graph-cli/vitest.config.ts",
    "type-check": "tsc",
    "publish": "pnpm publish --no-git-checks"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@graphif/project-graph-core": "workspace:*",
    "@graphif/prg-codec": "workspace:*"
  }
}
